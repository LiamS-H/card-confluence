@top Program { (Statement)* }

@skip { space | LineComment }

Statement { DomainDefinition | TagDefinition | GroupDefinition | ViewDefinition }

Query { queryContent }

DomainDefinition {
  DomainKeyword "[" Query "]"
}

Params {
  "(" (ParamItem ("," ParamItem)*)? ")"
}

ParamKey { identifier }
ParamValue { identifier }

ParamItem {
  ParamValue ":" ParamKey
}

TagDefinition {
  TagKeyword Identifier Params? "[" Query? "]"
}

GroupDefinition {
  GroupKeyword Identifier Params? (
    "{" (GroupItem ","?)* "}" |
    "[" (GroupItem ","?)* "]"
  )
}

GroupItem {
  Identifier | TagDefinition | GroupDefinition | MatchDefinition
}

ViewDefinition {
  ViewKeyword Identifier Params? "{" (ViewItem ","?)* "}"
}


ViewItem {
  Identifier | TagDefinition | GroupDefinition | MatchDefinition
}


MatchString {
  string | unquotedString
}

MatchDefinition {
  MatchKeyword MatchString
}


@external tokens scanQueryContent from "./tokens" { queryContent }

@tokens {
  identifier { $[a-zA-Z_\-] $[a-zA-Z0-9_\-]* }
  "[" "]" "{" "}" "(" ")" "," ":"
  space { $[ \t\n\r]+ }
  LineComment { "#" ![\\n]* }
  string { '"' (![\\\n"] | "\\" _)* '"' }
  unquotedString { ![ #"\t\r\n\v\f] ![ \t\r\n\v\f]* }
}

TagKeyword { @specialize<identifier, "tag"> }
ViewKeyword { @specialize<identifier, "view"> }
MatchKeyword { @specialize<identifier, "match"> }
GroupKeyword { @specialize<identifier, "group"> }
DomainKeyword { @specialize<identifier, "domain"> }
Identifier { identifier }
