{
  "name": "codemirror-lang-veldt-deck",
  "version": "0.1.0",
  "description": "veldt deck syntax language support for CodeMirror",
  "scripts": {
    "test": "mocha test/test.js",
    "prepare": "rollup -c"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "codemirror-lang-cardconfluence": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.11.0"
  },
  "devDependencies": {
    "@card-confluence/wasm-browser": "workspace:*",
    "@lezer/generator": "^1.8.0",
    "mocha": "^11.7.5",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.2.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "typescript": "^5.8.3",
    "@types/node": "25.0.0"
  },
  "license": "MIT"
}
